{
    "apiVersion": "batch/v1",
    "kind": "Job",
    "metadata": {
        "name": "rl-backbone-train-raw"
    },
    "spec": {
        "backoffLimit": 0,
        "parallelism": 1,
        "ttlSecondsAfterFinished": 86400,
        "template": {
            "spec": {
                "restartPolicy": "Never",
                "containers": [
                    {
                        "name": "rl-backbone-train-raw",
                        "image": "abrainone/ai-linux:cu12.6.3-latest",
                        "imagePullPolicy": "Always",
                        "env": [
                            {
                                "name": "HF_HOME",
                                "value": "/a/mm/.cache/huggingface"
                            }
                        ],
                        "securityContext": {
                            "allowPrivilegeEscalation": false,
                            "runAsUser": 1036,
                            "runAsGroup": 1376
                        },
                        "command": [
                            "/bin/bash",
                            "-c"
                        ],
                        "args": [
                            "export PYTHONPATH=/a/nn-dataset:/a/mm:$PYTHONPATH && python -m ab.gpt.TuneRLRaw"
                        ],
                        "workingDir": "/a/mm",
                        "resources": {
                            "requests": {
                                "nvidia.com/gpu": 1,
                                "cpu": 8,
                                "memory": "48Gi"
                            },
                            "limits": {
                                "nvidia.com/gpu": 1,
                                "cpu": 16,
                                "memory": "96Gi"
                            }
                        },
                        "volumeMounts": [
                            {
                                "mountPath": "/dev/shm",
                                "name": "shm"
                            },
                            {
                                "mountPath": "/a/mm",
                                "name": "v-exp"
                            },
                            {
                                "mountPath": "/a/nn-dataset",
                                "name": "v-data"
                            },
                            {
                                "mountPath": "/a/mm/cache/huggingface",
                                "name": "hf-cache"
                            }
                        ]
                    }
                ],
                "volumes": [
                    {
                        "name": "shm",
                        "emptyDir": {
                            "medium": "Memory",
                            "sizeLimit": "48Gi"
                        }
                    },
                    {
                        "name": "v-exp",
                        "hostPath": {
                            "path": "/shared/ssd/home/b-x-0522/nn-gpt_exp",
                            "type": "Directory"
                        }
                    },
                    {
                        "name": "v-data",
                        "hostPath": {
                            "path": "/shared/ssd/home/b-x-0522/lmur/nn-dataset",
                            "type": "Directory"
                        }
                    },
                    {
                        "name": "hf-cache",
                        "hostPath": {
                            "path": "/shared/ssd/home/b-x-0522/cache/huggingface",
                            "type": "DirectoryOrCreate"
                        }
                    }
                ]
            }
        }
    }
}