{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "sft-001"
  },
  "spec": {
    "backoffLimit": 0,
    "parallelism": 1,
    "ttlSecondsAfterFinished": 86400,
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "env": [
              {
                "name": "HF_HOME",
                "value": "/a/mm/.cache/huggingface"
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "runAsUser": 1036,
              "runAsGroup": 1376
            },
            "name": "sft",
            "image": "abrainone/ai-linux:cu12.6.3-latest",
            "imagePullPolicy": "Always",
            "command": [
              "/bin/bash",
              "-c"
            ],
            "args": [
              "export PYTHONPATH=/a/mm/nn-dataset:$PYTHONPATH && python SFT.py"
            ],
            "resources": {
              "requests": {
                "nvidia.com/gpu": 1,
                "cpu": 8,
                "memory": "32Gi"
              },
              "limits": {
                "nvidia.com/gpu": 1,
                "cpu": 16,
                "memory": "128Gi"
              }
            },
            "volumeMounts": [
              {
                "mountPath": "/dev/shm",
                "name": "shm"
              },
              {
                "mountPath": "/a/mm",
                "name": "v0"
              },
              {
                "mountPath": "/a/mm/nn-dataset",
                "name": "v1"
              },
              {
                "mountPath": "/a/mm/cache/huggingface",
                "name": "hf-cache"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "shm",
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "16Gi"
            }
          },
          {
            "name": "v0",
            "hostPath": {
              "path": "/shared/ssd/home/b-x-0522/nn-gpt",
              "type": "Directory"
            }
          },
          {
            "name": "v1",
            "hostPath": {
              "path": "/shared/ssd/home/b-x-0522/lmur/nn-dataset",
              "type": "Directory"
            }
          },
          {
            "name": "hf-cache",
            "hostPath": {
              "path": "/shared/ssd/home/b-x-0522/cache/huggingface",
              "type": "DirectoryOrCreate"
            }
          }
        ]
      }
    }
  }
}