{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "brute-exp-001"
  },
  "spec": {
    "parallelism": 1,
    "ttlSecondsAfterFinished": 86400,
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "runAsUser": 1036,
              "runAsGroup": 1376
            },
            "name": "brute-gen-exp",
            "image": "abrainone/ai-linux:cu12.6.3-latest",
            "imagePullPolicy": "Always",
            "command": [
              "/bin/bash",
              "-c"
            ],
            "args": [
              "export PYTHONPATH=/a/mm && python ab/gpt/brute/fract/backbone/NNAlterBackboneNet.py"
            ],
            "resources": {
              "requests": {
                "nvidia.com/gpu": 1,
                "cpu": 8,
                "memory": "32Gi"
              },
              "limits": {
                "nvidia.com/gpu": 1,
                "cpu": 16,
                "memory": "128Gi"
              }
            },
            "volumeMounts": [
              {
                "mountPath": "/dev/shm",
                "name": "shm"
              },
              {
                "mountPath": "/a/mm",
                "name": "v0"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "shm",
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "16Gi"
            }
          },
          {
            "name": "v0",
            "hostPath": {
              "path": "/shared/ssd/home/b-x-0522/nn-gpt_exp",
              "type": "Directory"
            }
          }
        ]
      }
    }
  }
}