{
    "apiVersion": "batch/v1",
    "kind": "Job",
    "metadata": {
        "name": "plot-exp"
    },
    "spec": {
        "backoffLimit": 0,
        "parallelism": 1,
        "ttlSecondsAfterFinished": 86400,
        "template": {
            "spec": {
                "restartPolicy": "Never",
                "containers": [
                    {
                        "name": "plot-exp",
                        "image": "abrainone/ai-linux:cu12.6.3-latest",
                        "imagePullPolicy": "Always",
                        "securityContext": {
                            "allowPrivilegeEscalation": false,
                            "runAsUser": 1036,
                            "runAsGroup": 1376
                        },
                        "command": [
                            "/bin/bash",
                            "-c"
                        ],
                        "args": [
                            "python 1.py"
                        ],
                        "workingDir": "/a/mm",
                        "resources": {
                            "requests": {
                                "cpu": 8,
                                "memory": "Gi"
                            },
                            "limits": {
                                "cpu": 16,
                                "memory": "128Gi"
                            }
                        },
                        "volumeMounts": [
                            {
                                "mountPath": "/dev/shm",
                                "name": "shm"
                            },
                            {
                                "mountPath": "/a/mm",
                                "name": "v0"
                            }
                        ]
                    }
                ],
                "volumes": [
                    {
                        "name": "shm",
                        "emptyDir": {
                            "medium": "Memory",
                            "sizeLimit": "16Gi"
                        }
                    },
                    {
                        "name": "v0",
                        "hostPath": {
                            "path": "/shared/ssd/home/b-x-0522/nn-gpt_exp",
                            "type": "Directory"
                        }
                    }
                ]
            }
        }
    }
}